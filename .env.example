# shim configuration. Copy to .env and fill in.
# .env is gitignored; never commit secrets.

# --- server ---

# Bind address. Keep 127.0.0.1 unless you understand the implications:
# binding to 0.0.0.0 exposes an unauthenticated proxy carrying your upstream
# API key on your LAN.
BIND_ADDR=127.0.0.1

# TCP port the server listens on.
PORT=8082

# --- upstream ---

# Adapter name. Stage 0/1 ships one: "deepseek".
ADAPTER=deepseek

# Upstream API key (required). Bearer token sent to the upstream.
UPSTREAM_API_KEY=

# Upstream base URL. For DeepSeek's OpenAI-compatible endpoint:
# https://api.deepseek.com/v1
UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# --- model mapping ---
#
# shim mirrors DeepSeek's server-side claude-prefix rule from the official
# Claude Code integration guide:
#   claude-opus*   → deepseek-v4-pro[1m]
#   claude-sonnet* → deepseek-v4-flash
#   claude-haiku*  → deepseek-v4-flash
# Override any role below. Leave unset to use the adapter's default.

# UPSTREAM_OPUS_MODEL=deepseek-v4-pro[1m]
# UPSTREAM_SONNET_MODEL=deepseek-v4-flash
# UPSTREAM_HAIKU_MODEL=deepseek-v4-flash

# Catch-all override for non-claude-{opus,sonnet,haiku} model names. When
# the client sends an arbitrary name (e.g. "deepseek-v4-pro" directly,
# "claude-3-5-sonnet-20240620" legacy), UPSTREAM_MODEL replaces it if set;
# otherwise the name passes through unchanged. Empty input uses
# "deepseek-chat" as the legacy fallback.
# UPSTREAM_MODEL=

# anthropic-passthrough — transparent proxy to a native Anthropic endpoint:
# ADAPTER=anthropic
# UPSTREAM_BASE_URL=https://api.anthropic.com
# UPSTREAM_API_KEY=<your Anthropic key>    # sent upstream as x-api-key
# shim forwards the client's anthropic-version / anthropic-beta; injects 2023-06-01 if absent.

# --- logging ---

# slog level: debug | info | warn | error.
LOG_LEVEL=info

# Redact secrets and prompt content in logs. Keep "true" outside debugging.
# When "false", Authorization headers and message bodies appear in logs.
LOG_REDACT=true

# --- limits ---

# Max request body in bytes. Default 1 MiB. Oversize → HTTP 413
# Anthropic-shaped error.
MAX_REQUEST_BYTES=1048576
