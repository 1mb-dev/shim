# shim configuration. Copy to .env and fill in.
# .env is gitignored; never commit secrets.

# --- server ---

# Bind address. Keep 127.0.0.1 unless you understand the implications:
# binding to 0.0.0.0 exposes an unauthenticated proxy carrying your upstream
# API key on your LAN.
BIND_ADDR=127.0.0.1

# TCP port the server listens on.
PORT=8082

# --- upstream adapter ---

# ADAPTER selects the upstream. The OpenAI-dialect presets (deepseek, openai,
# openrouter, ollama) share one translator; "anthropic" is a verbatim passthrough
# to a native Anthropic endpoint. See the preset reference below.
ADAPTER=deepseek

# Upstream API key — Bearer token sent upstream. Required for every adapter
# EXCEPT ollama (local, no auth). A missing key for an auth'd adapter fails
# loudly at server startup, not silently at first request.
UPSTREAM_API_KEY=

# Upstream base URL — optional. Each preset supplies its own default (see the
# reference below). Set this only to point at a non-default host (self-hosted,
# gateway, proxy). Leave empty to use the preset default for the chosen ADAPTER.
# UPSTREAM_BASE_URL=

# --- preset reference (default base URL + claude-*→upstream model mapping) ---
#
# claude-opus*/sonnet*/haiku* map to the upstream models below; override any
# role with UPSTREAM_{OPUS,SONNET,HAIKU}_MODEL, or non-claude names with
# UPSTREAM_MODEL. Model IDs verified 2026-05 — they drift with releases.
#
# deepseek    https://api.deepseek.com/v1
#   opus → deepseek-v4-pro   sonnet → deepseek-v4-flash   haiku → deepseek-v4-flash
#   (empty model → deepseek-chat; the [1m] variant only works on DeepSeek's
#    native /anthropic endpoint, not this OpenAI-format one)
#
# openai      https://api.openai.com/v1
#   opus → gpt-5.5   sonnet → gpt-5.5   haiku → gpt-5.4-mini
#   (chat-completions only — reasoning/"o"-series via the Responses API is not
#    supported; cost tip: UPSTREAM_SONNET_MODEL=gpt-5.4-mini)
#
# openrouter  https://openrouter.ai/api/v1
#   opus → anthropic/claude-opus-4.8   sonnet → anthropic/claude-sonnet-4.6
#   haiku → anthropic/claude-haiku-4.5
#   (defaults route claude-* back to Anthropic via OpenRouter — double
#    translation; shim measures only its own hop)
#
# ollama      http://localhost:11434/v1
#   one local model serves all roles → llama3.3
#   (no key needed; e.g. UPSTREAM_MODEL=qwen2.5-coder for coding)

# --- role overrides (optional; apply to the active ADAPTER) ---
# UPSTREAM_OPUS_MODEL=
# UPSTREAM_SONNET_MODEL=
# UPSTREAM_HAIKU_MODEL=
# Catch-all for non-claude-{opus,sonnet,haiku} model names (legacy aliases,
# direct upstream names). Replaces the name if set; otherwise passes through.
# UPSTREAM_MODEL=

# --- anthropic passthrough (transparent proxy to a native Anthropic endpoint) ---
# ADAPTER=anthropic
# UPSTREAM_BASE_URL=https://api.anthropic.com    # optional; this is the default
# UPSTREAM_API_KEY=<your Anthropic key>          # sent upstream as x-api-key
# No model mapping (request/response/SSE forwarded verbatim); shim forwards the
# client's anthropic-version / anthropic-beta and injects 2023-06-01 if absent.

# --- logging ---

# slog level: debug | info | warn | error.
LOG_LEVEL=info

# Redact secrets and prompt content in logs. Keep "true" outside debugging.
# When "false", Authorization headers and message bodies appear in logs.
LOG_REDACT=true

# --- limits ---

# Max request body in bytes. Default 1 MiB. Oversize → HTTP 413
# Anthropic-shaped error.
MAX_REQUEST_BYTES=1048576
